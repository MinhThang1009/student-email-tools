# Normalize line endings to LF for consistent local and CI behavior.
* text=auto eol=lf
*.sh text eol=lf

# Binary files: leave untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.xlsx binary
*.xls binary

# Keep repository metadata out of release archives.
/.github/** export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
